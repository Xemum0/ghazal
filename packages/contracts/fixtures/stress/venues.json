      "faq": [
        {
          "id": "S01-faq-how",
          "question": {
            "en": "How does booking work?",
            "ar": "كيف يتم الحجز؟"
          },
          "answer": {
            "en": "You get a voucher for KD 2 and send a request at the voucher price. The venue replies, and if it approves, the date is held for you for 24 hours while you confirm. You settle with the venue directly.",
            "ar": "تحصلون على كوبون بـ 2 د.ك وترسلون طلبًا بسعر الكوبون. ترد القاعة، وعند الموافقة يُحجز التاريخ لكم 24 ساعة لتأكيد الحجز. وتسدّدون للقاعة مباشرة."
          }
        },
        {
          "id": "S01-faq-visit",
          "question": {
            "en": "Can we visit the hall before booking?",
            "ar": "هل يمكن زيارة القاعة قبل الحجز؟"
          },
          "answer": {
            "en": "Yes. Book a visit from this page: a chat opens with the venue and Ghazal support to confirm your arrival. No voucher is needed.",
            "ar": "نعم. احجزوا زيارة من هذه الصفحة وتُفتح محادثة مع القاعة ودعم غزل لتأكيد وصولكم. لا حاجة إلى كوبون."
          }
        },
        {
          "id": "S01-faq-children",
          "question": {
            "en": "Are children allowed?",
            "ar": "هل يُسمح بحضور الأطفال؟"
          },
          "answer": {
            "en": "Children rules are listed per hall under Hall rules. Ladies’ receptions follow the boys’ age rule shown there.",
            "ar": "تظهر قواعد الأطفال لكل قاعة ضمن قواعد القاعة. تتبع الحفلات النسائية الحد العمري للأولاد المذكور هناك."
          }
        },
        {
          "id": "S01-faq-parking",
          "question": {
            "en": "What is the parking and arrival like?",
            "ar": "كيف هي المواقف والوصول؟"
          },
          "answer": {
            "en": "Parking and valet details are listed under Facilities. A separate entrance for the ladies’ hall is shown where it is offered.",
            "ar": "تفاصيل المواقف والفاليه ضمن المرافق. ويظهر المدخل المنفصل للقاعة النسائية حيثما يتوفر."
          }
        },
        {
          "id": "S01-faq-cut-off",
          "question": {
            "en": "What time does the event end?",
            "ar": "متى ينتهي الحفل؟"
          },
          "answer": {
