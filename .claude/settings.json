{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(npx stylelint:*)",
      "Bash(./tools/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Read(/**)",
      "Edit(/**)",
      "Write(/**)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(python3:*)",
      "Bash(magick:*)",
      "Bash(identify:*)",
      "Bash(compare:*)",
      "Bash(perl:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(cd:*)",
      "Bash(xargs:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(date:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(true:*)",
      "Bash(opencode run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config --get:*)",
      "Workflow",
      "Agent",
      "Skill",
      "ToolSearch",
      "Monitor",
      "TaskStop",
      "SendMessage",
      "ScheduleWakeup",
      "Bash(npx:*)",
      "Bash(pgrep:*)",
      "Bash(open:*)",
      "Bash(opencode:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun xcodebuild:*)",
      "Bash(xcodebuild:*)",
      "Bash(adb:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(git restore --staged:*)",
      "CronCreate",
      "CronList",
      "CronDelete",
      "TaskOutput",
      "SendUserFile",
      "NotebookEdit"
    ],
    "ask": [
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(**/*Nulled*)",
      "Read(**/*.rar)",
      "Edit(**/*Nulled*)",
      "Edit(**/*.rar)",
      "Write(**/*Nulled*)",
      "Write(**/*.rar)",
      "Bash(*Nulled*)",
      "Bash(*.rar*)",
      "Bash(unrar:*)",
      "Bash(7z:*)",
      "Bash(7za:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(/project.md)",
      "Edit(/Ghazal_PRD_EN.pdf)",
      "Write(/project.md)",
      "Write(/Ghazal_PRD_EN.pdf)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/ports.mjs check design 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
