{
  "name": "design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "description": "Ghazal Design Studio: web prototype of the Client App and Hotel App (Vite + React + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm typecheck && pnpm lint:css && pnpm check:cycles",
    "check:cycles": "node scripts/check-cycles.mjs",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "shots": "node scripts/shots.mjs",
    "snap": "node scripts/snap.mjs"
  },
  "dependencies": {
    "@gz/contracts": "workspace:*",
    "@gz/design-tokens": "workspace:*",
    "@gz/i18n": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.50.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
