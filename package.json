{
  "name": "ghazal",
  "private": true,
  "version": "0.0.0",
  "description": "Ghazal: premium wedding-venue marketplace for Kuwait. Monorepo root; scripts only.",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -F design dev",
    "build": "pnpm -F design build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -F design lint",
    "lint:css": "pnpm -F design lint:css",
    "tokens": "node packages/design-tokens/scripts/build.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build.mjs --check",
    "i18n:check": "node packages/i18n/scripts/check.mjs",
    "shots": "node design/scripts/shots.mjs",
    "contracts:check": "pnpm -F @gz/contracts check && pnpm -F @gz/contracts validate",
    "verify": "pnpm typecheck && pnpm lint && pnpm tokens:check && pnpm i18n:check && pnpm contracts:check",
    "parity:ref": "node tools/parity/ref-shots.mjs",
    "parity": "node tools/parity/parity.mjs",
    "flutter:get": "flutter pub get",
    "flutter:analyze": "flutter analyze",
    "flutter:rules": "bash tools/check-dart-rules.sh",
    "flutter:routes": "node tools/gen-routes.mjs",
    "flutter:edges": "node tools/check-nav-edges.mjs",
    "flutter:sweep": "node tools/flutter-sweep.mjs",
    "flutter:icons": "node tools/gen-icons.mjs",
    "flutter:illustrations": "node tools/export-illustrations.mjs",
    "flutter:test": "node tools/flutter-test-all.mjs",
    "flutter:verify": "pnpm flutter:analyze && pnpm flutter:rules && pnpm flutter:test",
    "fshot": "node tools/fshot.mjs",
    "l10n": "node tools/gen-l10n.mjs --gen && node tools/export-message-cases.mjs",
    "l10n:ui": "node tools/gen-l10n.mjs --gen --only ui",
    "l10n:check": "node tools/gen-l10n.mjs --check && node tools/export-message-cases.mjs --check && node tools/export-format-cases.mjs --check",
    "format-cases": "node tools/export-format-cases.mjs",
    "ports": "node tools/ports.mjs",
    "parity:gallery": "node tools/parity/gallery-ref.mjs",
    "parity:board": "node tools/parity/board.mjs",
    "parity:text": "node tools/parity/web-text.mjs",
    "parity:content": "node tools/parity/content.mjs",
    "parity:geo": "node tools/parity/geo.mjs",
    "probe": "node tools/parity/probe.mjs"
  }
}
